# Configuración del Proveedor LLM (openai | anthropic)
LLM_PROVIDER=openai

# OpenAI Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# App Configuration
APP_NAME="CAG Software Estimator API"
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# URL base del servicio IA, usada por el cliente Streamlit
API_BASE_URL=http://localhost:8000/api/v1

# Versión de prompt por defecto (app/prompts/estimation/<version>/)
PROMPT_VERSION=v1

# Caché de respuestas del LLM (Redis). En local, levanta Redis con:
#   docker run -d --name redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400
