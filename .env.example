# Anthropic Settings (proveedor principal, único)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini: proveedor de respaldo gratuito si Anthropic falla.
# API key gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# App Configuration
APP_NAME="CAG Software Estimator API"
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# URL base del servicio IA, usada por el cliente Streamlit
API_BASE_URL=http://localhost:8000/api/v1

# Versión de prompt por defecto (app/prompts/estimation/<version>/)
PROMPT_VERSION=v1

# Caché de respuestas del LLM (Redis). En local, levanta Redis con:
#   docker run -d --name redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400
